@echo off
rem The variant of activate.bat for the command processor of Windows NT 3.x.

set VIRTUAL_ENV=__VENV_DIR__

if "%PROMPT%"=="" set PROMPT=$P$G
if not "%_OLD_VIRTUAL_PROMPT%"=="" set PROMPT=%_OLD_VIRTUAL_PROMPT%
if not "%_OLD_VIRTUAL_PYTHONHOME%"=="" set PYTHONHOME=%_OLD_VIRTUAL_PYTHONHOME%

set _OLD_VIRTUAL_PROMPT=%PROMPT%
set PROMPT=(__VENV_PROMPT__) %PROMPT%

if not "%PYTHONHOME%"=="" set _OLD_VIRTUAL_PYTHONHOME=%PYTHONHOME%
set PYTHONHOME=

if not "%_OLD_VIRTUAL_PATH%"=="" set PATH=%_OLD_VIRTUAL_PATH%
if "%_OLD_VIRTUAL_PATH%"=="" set _OLD_VIRTUAL_PATH=%PATH%

set PATH=%VIRTUAL_ENV%\__VENV_BIN_NAME__;%PATH%
set VIRTUAL_ENV_PROMPT=__VENV_PROMPT__
