@echo off
rem The variant of deactivate.bat for the command processor of Windows NT 3.x.

if not "%_OLD_VIRTUAL_PROMPT%"=="" set PROMPT=%_OLD_VIRTUAL_PROMPT%
set _OLD_VIRTUAL_PROMPT=

if not "%_OLD_VIRTUAL_PYTHONHOME%"=="" set PYTHONHOME=%_OLD_VIRTUAL_PYTHONHOME%
set _OLD_VIRTUAL_PYTHONHOME=

if not "%_OLD_VIRTUAL_PATH%"=="" set PATH=%_OLD_VIRTUAL_PATH%
set _OLD_VIRTUAL_PATH=

set VIRTUAL_ENV=
set VIRTUAL_ENV_PROMPT=
